# Castor Tracker — variables des scripts d'exploitation (configure, déploiement des fonctions, sauvegarde).
# Copier en .env sur la machine qui lance les scripts : ce fichier n'est jamais commité.
# Aucune de ces valeurs ne doit être collée dans un chat ou un ticket.
# Sur Supabase Cloud, le workflow GitHub « Supabase Cloud » fait tout sans .env (voir le README, section A).

# URL publique de l'API : https://<ref>.supabase.co (cloud) ou domaine du service Kong (auto-hébergé).
SUPABASE_URL=https://api.castor.exemple.fr

# Clés d'API — Supabase Cloud : nouvelles clés (Settings › API Keys).
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Clés d'API — auto-hébergé : clés historiques (anon, service_role) du service Coolify.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Adresse de la PWA (redirections des liens magiques et des invitations).
SITE_URL=https://castor.exemple.fr
# Premier administrateur (créé s'il n'existe pas ; mot de passe demandé au lancement).
ADMIN_EMAIL=

# Accès à Postgres — au choix :
#  1) conteneur de la base sur cette machine (auto-hébergé, sur l'hôte Coolify) :
DB_CONTAINER=
#  2) ou chaîne de connexion directe ; sur Supabase Cloud, bouton « Connect » › Session pooler :
# DATABASE_URL="postgresql://postgres.<ref>:motdepasse@aws-1-eu-west-3.pooler.supabase.com:5432/postgres"
# (guillemets si la valeur contient & ou ?)
# Mot de passe Postgres (sauvegardes via le conteneur).
POSTGRES_PASSWORD=

# URL appelée par pg_cron/pg_net pour joindre les fonctions. Par défaut : $SUPABASE_URL/functions/v1.
# Plus direct sur le réseau Docker de Coolify : http://supabase-kong-<uuid>:8000/functions/v1
CASTOR_FUNCTIONS_URL=

# Déploiement des Edge Functions en auto-hébergé (volume « functions » du service Supabase dans Coolify).
FUNCTIONS_DIR=/data/coolify/services/<uuid>/volumes/functions
# Conteneur à redémarrer (détecté automatiquement s'il est vide).
FUNCTIONS_CONTAINER=
# Si les scripts tournent ailleurs que sur l'hôte Coolify : cible SSH (ex. root@homelab).
FUNCTIONS_SSH=

# Sauvegardes quotidiennes (ENF-07) : répertoire monté du NAS, rétention en jours.
BACKUP_DIR=/mnt/nas/castor-backups
BACKUP_KEEP_DAYS=30
